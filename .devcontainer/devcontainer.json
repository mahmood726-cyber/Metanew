{
  "name": "EvidenceOS PRIME - Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/rocker-org/devcontainer-features/r-apt:latest": {
      "version": "4.3"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "REditorSupport.r",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "r.rpath.linux": "/usr/bin/R"
      }
    }
  },

  "forwardPorts": [3838, 8000, 8001],
  "portsAttributes": {
    "3838": {
      "label": "Shiny App",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "FastAPI (Legacy)",
      "onAutoForward": "silent"
    },
    "8001": {
      "label": "AI Copilot API",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  "remoteUser": "vscode",

  "mounts": [
    "source=${localWorkspaceFolder}/outputs,target=${containerWorkspaceFolder}/outputs,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/data,target=${containerWorkspaceFolder}/data,type=bind,consistency=cached"
  ]
}
