# EvidenceOS PRIME - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# R
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj
.httr-oauth

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Application outputs
outputs/*.docx
outputs/*.pdf
outputs/*.pptx
outputs/*.json
outputs/*.xlsx
!outputs/.gitkeep

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Environment
.env
.env.local
.env.production
.env.staging
.env.*.local

# SECURITY FIX: Secrets and sensitive files
**/secrets/
**/secrets.yaml
**/secrets.yml
**/*_secret*.yaml
**/*_secret*.yml
**/*_secret*.json
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
service-account.json
kubeconfig
.kube/config

# Data (exclude large datasets, keep samples)
data/large_datasets/
!data/sample_*.csv
