# EvidenceOS PRIME - Environment Variables
# Copy this file to .env and customize for your environment

# Environment (development/staging/production)
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=info

# Cache Configuration
CACHE_ENABLED=true
CACHE_DIR=cache
CACHE_TTL_SECONDS=3600

# Database Configuration (optional)
DATABASE_ENABLED=false
DATABASE_TYPE=sqlite
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=evidenceos.db
DATABASE_USER=
DATABASE_PASSWORD=

# Security Configuration
ENABLE_AUTH=false
SECRET_KEY=change-me-in-production-use-strong-random-key
ENABLE_HTTPS=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3838,http://127.0.0.1:3838

# Rate Limiting
RATE_LIMIT=100/minute

# Analysis Configuration
MAX_STUDIES=1000
MIN_STUDIES_META_ANALYSIS=2
DEFAULT_CONFIDENCE_LEVEL=0.95

# Health Economics Configuration
DEFAULT_CURRENCY=USD
DEFAULT_WTP_THRESHOLD=50000
DEFAULT_DISCOUNT_RATE=0.03
N_SIMULATIONS=1000

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
STRUCTURED_LOGGING=false
