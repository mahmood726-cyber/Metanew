# EvidenceOS PRIME - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins for CORS
# In production, restrict to your actual frontend URLs
ALLOWED_ORIGINS=http://localhost:3838,http://localhost:8000,http://localhost:8001,http://127.0.0.1:3838

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Main FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# AI Copilot FastAPI backend
AI_API_HOST=0.0.0.0
AI_API_PORT=8001
AI_API_WORKERS=2

# API URLs (for frontend to connect)
API_BASE_URL=http://localhost:8000
AI_BACKEND_URL=http://localhost:8001

# ============================================================================
# SHINY CONFIGURATION
# ============================================================================
SHINY_PORT=3838
SHINY_LOG_LEVEL=INFO
SHINY_HOST=0.0.0.0

# ============================================================================
# RATE LIMITING
# ============================================================================
# Rate limits for API endpoints (requests per minute)
RATE_LIMIT_NLQ=10
RATE_LIMIT_INTERPRET=30
RATE_LIMIT_HEALTH=60

# ============================================================================
# SECURITY
# ============================================================================
# Set to 'true' in production to enforce HTTPS
ENFORCE_HTTPS=false

# Secret key for session management (generate with: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here

# JWT settings (if implementing authentication)
# JWT_SECRET_KEY=your-jwt-secret-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=30

# ============================================================================
# DATABASE (Optional - for future use)
# ============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/evidenceos
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
CACHE_DIR=cache/parquet
CACHE_MAX_AGE_DAYS=30

# ============================================================================
# LLM CONFIGURATION (Optional - for AI Copilot)
# ============================================================================
# Path to local LLM model file (llama.cpp compatible)
# Leave empty to use rule-based parser only
LLM_MODEL_PATH=

# LLM parameters
LLM_CONTEXT_WINDOW=2048
LLM_THREADS=4
LLM_GPU_LAYERS=0

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/evidenceos.log

# ============================================================================
# HEALTH ECONOMICS DEFAULTS
# ============================================================================
DEFAULT_COUNTRY=UK
DEFAULT_CURRENCY=GBP
DEFAULT_WTP_THRESHOLD=20000
DEFAULT_DISCOUNT_RATE=0.035
DEFAULT_TIME_HORIZON=10

# ============================================================================
# FILE UPLOAD LIMITS
# ============================================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls,.json

# ============================================================================
# OUTPUTS CONFIGURATION
# ============================================================================
OUTPUT_DIR=outputs
REPORT_TEMPLATE_DIR=frontend/templates

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Docker Compose environment
COMPOSE_PROJECT_NAME=evidenceos
COMPOSE_HTTP_TIMEOUT=300

# ============================================================================
# MONITORING (Optional - for production)
# ============================================================================
# SENTRY_DSN=
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ============================================================================
# BACKUP CONFIGURATION (Optional)
# ============================================================================
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=90
# AUTO_BACKUP_ENABLED=true

# ============================================================================
# DEVELOPMENT VS PRODUCTION
# ============================================================================
# Set to 'production' to enable production settings
ENVIRONMENT=development

# Enable debug mode (never use in production!)
DEBUG=false

# Enable hot reload for development
RELOAD=false
