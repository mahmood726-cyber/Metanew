# EvidenceOS PRIME - Environment Configuration
# Copy this file to .env and update with your values

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=EvidenceOS PRIME API
HOST=0.0.0.0
PORT=8000

# Security (IMPORTANT: Change in production!)
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Add your frontend domains
ALLOWED_ORIGINS=http://localhost:3838,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600
ENABLE_CACHE=true

# Database (optional)
DATABASE_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# API Authentication
API_KEY_HEADER=X-API-Key
VALID_API_KEYS=

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.json

# Analysis Limits
MAX_STUDIES=1000
MAX_OBSERVATIONS=10000

# Feature Flags
ENABLE_BAYESIAN_MA=false
ENABLE_AI_COPILOT=true
