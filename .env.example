# EvidenceOS PRIME Environment Configuration
# Copy this file to .env and configure with your values

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Environment: development, staging, production
APP_ENV=development

# Application name and version
APP_NAME="EvidenceOS PRIME"
APP_VERSION="2.0.0"

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================

# JWT Secret Key (REQUIRED - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Enable/disable authentication (true/false)
# Set to false only for development/testing
ENABLE_AUTH=true

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================

# Allowed origins for CORS (comma-separated)
# Development: allow all with "*"
# Production: specify exact domains
ALLOWED_ORIGINS=http://localhost:3838,http://localhost:8000,https://yourdomain.com

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

# API Base URL for R Shiny frontend
API_BASE_URL=http://localhost:8000

# AI Backend URL (if using separate AI service)
AI_BACKEND_URL=http://localhost:8001

# Rate limiting
API_RATE_LIMIT=30/minute

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL connection (for production multi-user setup)
DATABASE_URL=postgresql://user:password@localhost:5432/evidenceos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evidenceos
DB_USER=evidenceos_user
DB_PASSWORD=change-this-secure-password

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==============================================================================
# REDIS CONFIGURATION (Distributed Caching)
# ==============================================================================

# Redis connection for distributed caching
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-this-redis-password

# Redis cache TTL (seconds)
CACHE_TTL=3600

# ==============================================================================
# SHINY SERVER CONFIGURATION
# ==============================================================================

# Shiny server port
SHINY_PORT=3838

# Shiny log level: INFO, WARNING, ERROR
SHINY_LOG_LEVEL=INFO

# Maximum upload file size (MB)
SHINY_MAX_UPLOAD_MB=100

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=json

# Log file path (optional, leave empty for stdout only)
LOG_FILE_PATH=/var/log/evidenceos/app.log

# Log rotation (MB)
LOG_MAX_SIZE_MB=100

# Number of log files to keep
LOG_BACKUP_COUNT=10

# ==============================================================================
# AI/LLM CONFIGURATION (Optional)
# ==============================================================================

# LLM model path (for local models)
LLM_MODEL_PATH=/models/llama-7b-q4.gguf

# OpenAI API Key (if using OpenAI instead of local)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model name
OPENAI_MODEL=gpt-4

# LLM temperature (0.0 - 1.0)
LLM_TEMPERATURE=0.7

# Max tokens for LLM responses
LLM_MAX_TOKENS=2000

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Prometheus metrics endpoint enabled
ENABLE_METRICS=true

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# Sentry environment
SENTRY_ENVIRONMENT=production

# ==============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ==============================================================================

# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@evidenceos.com
SMTP_FROM_NAME=EvidenceOS PRIME

# Enable email notifications
ENABLE_EMAIL_NOTIFICATIONS=false

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================

# Backup directory
BACKUP_DIR=/backups/evidenceos

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

# Number of backups to retain
BACKUP_RETENTION_DAYS=30

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Trusted hosts (comma-separated, for production)
TRUSTED_HOSTS=evidenceos.com,www.evidenceos.com

# Enable HTTPS redirect
FORCE_HTTPS=true

# Session timeout (minutes)
SESSION_TIMEOUT=30

# Maximum concurrent requests per user
MAX_CONCURRENT_REQUESTS=10

# ==============================================================================
# HEALTH ECONOMICS DEFAULTS
# ==============================================================================

# Default country for HE analysis
DEFAULT_HE_COUNTRY=uk

# Default WTP threshold (currency)
DEFAULT_WTP_THRESHOLD=20000

# Default discount rate (%)
DEFAULT_DISCOUNT_RATE=3.5

# Default time horizon (years)
DEFAULT_TIME_HORIZON=10

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable experimental features
ENABLE_BAYESIAN_NMA=false
ENABLE_IPD_META_ANALYSIS=false
ENABLE_ADVANCED_REPORTING=true
ENABLE_COLLABORATION=false

# ==============================================================================
# DEVELOPMENT/DEBUG SETTINGS
# ==============================================================================

# Debug mode (never enable in production!)
DEBUG=false

# Enable FastAPI docs (/docs, /redoc)
ENABLE_API_DOCS=true

# Enable SQL query logging
LOG_SQL_QUERIES=false

# Enable performance profiling
ENABLE_PROFILING=false

# ==============================================================================
# DOCKER/DEPLOYMENT SETTINGS
# ==============================================================================

# Docker network name
DOCKER_NETWORK=evidenceos-network

# Container restart policy
RESTART_POLICY=unless-stopped

# Resource limits
MEMORY_LIMIT=2g
CPU_LIMIT=2.0

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. NEVER commit .env file to version control!
# 2. Use strong, unique passwords for all services
# 3. Rotate JWT_SECRET_KEY regularly in production
# 4. In production, set APP_ENV=production and ENABLE_AUTH=true
# 5. Configure proper CORS origins (never use "*" in production)
# 6. Enable HTTPS and set FORCE_HTTPS=true
# 7. Configure database backups
# 8. Set up monitoring and alerting
# 9. Review security settings before deployment
# 10. Use environment-specific .env files (.env.dev, .env.prod)
#
# ==============================================================================
