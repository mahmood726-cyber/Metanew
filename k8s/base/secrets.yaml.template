# SECURITY: This is a template file. DO NOT commit actual secrets to git!
# Create secrets.yaml from this template and add your actual values.
# The secrets.yaml file is gitignored to prevent accidental commits.

apiVersion: v1
kind: Secret
metadata:
  name: evidenceos-secrets
  namespace: evidenceos
  labels:
    app: evidenceos
type: Opaque
stringData:
  # Database credentials
  # Generate with: openssl rand -base64 32
  postgres-user: evidenceos
  postgres-password: <GENERATE_RANDOM_PASSWORD>
  database-url: postgresql://evidenceos:<POSTGRES_PASSWORD>@postgres-service:5432/evidenceos

  # JWT secret (minimum 64 characters recommended)
  # Generate with: openssl rand -base64 64
  jwt-secret: <GENERATE_RANDOM_JWT_SECRET>

  # Admin initial credentials
  # These are used only on first deployment to create the admin user
  admin-username: admin
  admin-password: <GENERATE_RANDOM_ADMIN_PASSWORD>
  analyst-password: <GENERATE_RANDOM_ANALYST_PASSWORD>

  # Optional: CORS allowed origins for production
  cors-allowed-origins: https://evidenceos.com,https://app.evidenceos.com

# INSTRUCTIONS:
# 1. Copy this file to secrets.yaml: cp secrets.yaml.template secrets.yaml
# 2. Run the generation script: ./generate-secrets.sh
# 3. Or manually replace <GENERATE_*> placeholders with actual secure values
# 4. Apply to cluster: kubectl apply -f secrets.yaml
# 5. NEVER commit secrets.yaml to git!
